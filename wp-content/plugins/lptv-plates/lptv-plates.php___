/**
 * Add custom fields to general panel
 * font & template ID
 */
add_action('woocommerce_product_options_pricing', 'add_lptvplate_pricing');
global $fonts, $fields, $extraFields;

$fonts = ['1', '1a', '2', '2a'];
$fields = ['font', 'minChar', 'maxChar', 'xPos', 'yPos', 'fontSize', 'fontColor'];
$extraFields = ["symbols", "edecal", "saftydecal", "statedecal", 'products_image', 'products_id', 'products_instructions', 'products_parts', 'options_2'];

function add_lptvplate_pricing()
{

    global $product_object, $fonts, $fields, $extraFields;
    ?>
    <div class='options_group show_if_lptvplate'>
        <?php

        woocommerce_wp_text_input(
            array(
                'id' => '_plate_template_id',
                'label' => __('Plate template ID'),
                'value' => $product_object->get_meta('_plate_template_id', true),
                'default' => '',
                'placeholder' => 'Set plate template ID'
            )
        );

        foreach ($fonts as $font) {
            echo '<div class="" style="padding-left:20px;"><div style="font-weight: bold;font-size: 14px">Font ' . $font . '</div>';
            echo '<div style="display: flex; flex-direction: row;margin-bottom: 8px;gap:12px;">';
            foreach ($fields as $field) {
                $val = $product_object->get_meta('_plate_' . $field . $font, true);
                echo '<input type="text" placeholder="' . $field . $font . '" name="_plate_' . $field . $font . '" style="width:90px" value="' . $val . '"/>';
            }
            echo '</div></div>';
        }


        echo '<div class="" style="padding-left:20px;"><div style="font-weight: bold;font-size: 14px">Extra</div>';
        echo '<div style="display: flex; flex-direction: row;margin-bottom: 8px;gap:12px;">';
        foreach ($extraFields as $field) {
            $val = $product_object->get_meta('_plate_' . $field, true);
            echo '<input type="text" placeholder="' . $field . '" name="_plate_' . $field . '" style="width:90px" value="' . $val . '"/>';
        }
        echo '</div></div>';


        echo '<div style="display: flex;flex-direction: row;gap:12px;margin-left: 20px;margin-top:22px;margin-bottom:22px;"><img src="" id="plateSample" style="width:200px;height:auto;"/><img src="" id="plateSampleDemo" style="width:200px;height:auto;margin-left: 20px;"/></div>';

        ?>
    </div>
<?php
}

add_action('admin_footer', 'enable_js_on_wc_product');
function enable_js_on_wc_product()
{
    global $post, $product_object;

    if (!$post || $post->post_type != 'product') {
        return;
    }


    $is_lptvplate = $product_object && 'lptvplate' === $product_object->get_type() ? true : false;

?>
    <script type='text/javascript'>
        jQuery(function($) {
            //for Price tab
            $('#general_product_data .pricing').addClass('show_if_lptvplate');
            $('.inventory_options').addClass('show_if_lptvplate').show();

            <?php if ($is_lptvplate) { ?>
                $('#general_product_data .pricing').show();
                reloadSample();

                $('input#_plate_template_id').on('keyup', function() {
                    reloadSample()
                });

                function reloadSample() {
                    let id = $('input#_plate_template_id').val();
                    $('#plateSample').attr('src', '/wp-content/plugins/lptv-plates/images/pngs/blank' + id + '.png')
                    $('#plateSampleDemo').attr('src', '/wp-content/plugins/lptv-plates/images/' + id + '.gif')
                }
            <?php } ?>
        });
    </script>
<?php
}

/**
 * Save the product custom data
 */
add_action('woocommerce_process_product_meta_lptvplate', 'save_lptvplate_settings');
function save_lptvplate_settings($post_id)
{
    global $fields, $fonts, $extraFields;
    foreach ($fonts as $font) {

        foreach ($fields as $field) {
            $val = isset($_POST['_plate_' . $field . $font]) ? sanitize_text_field($_POST['_plate_' . $field . $font]) : '';
            update_post_meta($post_id, '_plate_' . $field . $font, $val);
        }
    }

    // save extra
    foreach ($extraFields as $field) {
        $val = isset($_POST['_plate_' . $field]) ? sanitize_text_field($_POST['_plate_' . $field]) : '';
        update_post_meta($post_id, '_plate_' . $field, $val);
    }

    if ($_POST['_plate_template_id']) {
        update_post_meta($post_id, '_plate_template_id', $_POST['_plate_template_id']);
    }
}


