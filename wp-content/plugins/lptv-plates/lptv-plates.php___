// Add data to cart item
add_filter('woocommerce_add_cart_item_data', 'lptvplate_add_cart_item_data', 25, 2);
function lptvplate_add_cart_item_data($cart_item_data, $product_id)
{

    $product = wc_get_product($product_id);
    if ($product->get_type() != 'lptvplate') {
        return $cart_item_data;
    }

    // Set the data for the cart item in cart object
    $data = array();

    foreach (['_plate_text1', '_plate_text2', '_decal_year'] as $key) {
        if (isset($_POST[$key])) {
            $cart_item_data['custom_data'][$key] = $data[$key] = $_POST[$key];
        }
    }

    return $cart_item_data;
}

add_filter('woocommerce_cart_item_thumbnail', 'generateLPTVplateThumbnail', 20, 3);
add_filter('woocommerce_order_item_thumbnail', 'gen_thumb_product_email', 20, 2);

// generate thumbnail with custom size especially for email
function gen_thumb_product_email($image, $cart_item)
{

    $product = null;
    $product = wc_get_product($cart_item['product_id']);
    $template_id = $product->get_meta('_plate_template_id', true);

    if ($product->get_type() == 'lptvplate' && $template_id) {
        $image = generateLPTVplateThumbnail($image, $cart_item);
        $image = str_replace('<img ', '<img width="90px" ', $image);
    }

    return $image;
}

function generateLPTVplateThumbnail($image, $cart_item, $cart_item_key = false)
{



    // generate image with model and text
    if (is_admin() && $cart_item_key) {
        $product = $cart_item_key->get_product();
        $template_id = $product->get_meta('_plate_template_id', true);

        if ($product->get_type() == 'lptvplate' && $template_id) {
            $text1 = '';
            $text2 = '';
            foreach ($cart_item_key->get_data()['meta_data'] as $data) {
                if ($data->key == '_plate_text1') {
                    $text1 = $data->value;
                }
                if ($data->key == '_plate_text2') {
                    $text2 = $data->value;
                }
            }

            $modelId = $product->get_meta('_plate_template_id', true);

            if ($modelId) {
                $url = '/wp-content/plugins/lptv-plates/includes/lpgenI.php?productId=' . $modelId . '&text1=' . urlencode($text1) . '&text2=' . urlencode($text2);

                return '<img src="' . $url . '"/>';
            }
        } else {
            $product = $cart_item_key->get_product();
            if ($product) {
                return $product->get_image('full');
            }
        }
    } else {
        $product = wc_get_product($cart_item['product_id']);
    }

    if ($product->get_type() == 'lptvplate') {

        $template_id = $product->get_meta('_plate_template_id', true);
        if ($template_id) {
            $text1 = @$cart_item['custom_data']['_plate_text1'];
            $text2 = @$cart_item['custom_data']['_plate_text2'];

            if ($cart_item_key == false) {
                $text1 = $cart_item->get_meta('_plate_text1');
                $text2 = $cart_item->get_meta('_plate_text2');
            }

            $modelId = $product->get_meta('_plate_template_id', true);
            $url = get_site_url() . "/wp-content/plugins/lptv-plates/includes/lpgenI.php?productId=$modelId&text1=$text1&text2=$text2";

            return '<img src="' . $url . '"/>';
        } else {
            if(!strpos($image, 'licenseplates.tv')) {
                return str_replace('src="/', 'src="' . get_site_url() . '/', $image);
            }
        }
    }

    return $image;
}

// admin thumbnail
add_filter('woocommerce_admin_order_item_thumbnail', 'generateLPTVplateThumbnail', 20, 3);

// Display custom data on cart and checkout page.
add_filter('woocommerce_get_item_data', 'lptvplate_get_item_data', 25, 2);
function lptvplate_get_item_data($cart_data, $cart_item)
{

    $product = wc_get_product($cart_item['product_id']);
    if ($product->get_type() != 'lptvplate') {
        return $cart_data;
    }

    if (!empty($cart_item['custom_data'])) {

        foreach ($cart_item['custom_data'] as $key => $value) {

            if (str_contains($key, 'plate_')) {

                $title = str_replace('plate_', '', $key);
                $title = str_replace('_', '', $title);

                $cart_data[] = array(
                    'name' => $title,
                    'display' => $value
                );
            }
        }
    }


    return $cart_data;
}

// save in order
add_action('woocommerce_add_order_item_meta', 'lptvplate_add_order_item_meta', 10, 3);
function lptvplate_add_order_item_meta($item_id, $cart_item, $cart_item_key)
{
    if (isset($cart_item['custom_data'])) {
        $values = array();
        foreach ($cart_item['custom_data'] as $key => $val) {
            wc_add_order_item_meta($item_id, $key, $val);
        }
    }
}

// add meta by default to all products that has type lptvplate if we add items from admin
add_action('woocommerce_new_order_item', function ($item_id, $item, $order_id) {

    if (is_admin()) {
        if ($item->get_product()->is_type('lptvplate')) {
            $data_store = WC_Data_Store::load('order-item');
            $data_store->add_metadata($item_id, "_plate_text1", " ", false);
            $data_store->add_metadata($item_id, "_plate_text2", " ", false);
            $data_store->add_metadata($item_id, "_decal_year", " ", false);
        }

        if ($item->get_product()->get_sku() == 'onrequestplate' && is_admin()) {
            $data_store = WC_Data_Store::load('order-item');
            $data_store->add_metadata($item_id, "_description", " ", false);
        }
    }
}, 15, 3);

/**
 * Replace variable in description
 */
add_filter('the_content', function ($content) {

    global $product;
    if ($product && $product->get_type() == 'lptvplate') {
        $modelId = $product->get_meta('_plate_template_id', true);
        if ($modelId) {
            preg_match('/([0-9]{4})/', $modelId, $matches);

            if (count($matches) > 0) {
                $year = $matches[0];

                $content = str_replace('**year**', $year, $content);
                $content = str_replace('**model**', $modelId, $content);

                // remove h2 product id string from the description
                $content = preg_replace('/(<h2>Product ID.*<\/h2>)/', '', $content);
            }
        }
    }

    return $content;
});

