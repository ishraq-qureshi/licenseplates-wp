/**
 * Add ability to edit sorting field for products
 */
// Add the field to the General tab
add_action('woocommerce_product_options_general_product_data', 'add_custom_sort_order_field');
function add_custom_sort_order_field()
{
    woocommerce_wp_text_input(array(
        'id'          => '_plate_products_sort_order',
        'label'       => __('Custom Sort Order', 'txtdomain'),
        'description' => __('Set a numerical value. Products with a value set will be sorted by this number first, then alphabetically.', 'txtdomain'),
        'desc_tip'    => true,
        'type'        => 'number',
    ));
}

// Save the field value
add_action('woocommerce_process_product_meta', 'save_custom_sort_order_field');
function save_custom_sort_order_field($product_id)
{
    $product = wc_get_product($product_id);
    $sort_order = isset($_POST['_plate_products_sort_order']) ? absint($_POST['_plate_products_sort_order']) : ''; // Use absint to ensure a positive integer
    $product->update_meta_data('_plate_products_sort_order', $sort_order);
    $product->save();
}
