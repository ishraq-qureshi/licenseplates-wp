});


/**
 * Attach old order id to order title
 */
add_action('manage_shop_order_posts_custom_column', 'lptvplate_change_order_title');
function lptvplate_change_order_title($column)
{
    global $the_order;
    global $post;

    if ($column == 'order_number') {

        $old_order_id = get_post_meta($post->ID, '_old_order_id', true);
        if ($old_order_id) {
            echo '[' . $old_order_id . '] ';
        }
    }
}

add_action('woocommerce_admin_order_data_after_order_details', function ($order) {
    $old_order_id = get_post_meta($order->get_id(), '_old_order_id', true);
    if ($old_order_id) {
        echo '<p>Old order ID: <strong> ' . $old_order_id . '</strong></p>';
    }
}, 5, 1);

// hook filter se_get_product_image_post and return product custom image url
add_filter('se_get_product_image_post', function ($image_url, $image_id, $size) {

    $log_file = __DIR__ . '/lptv-debug.log';
    $log_message = sprintf(
        '[%s] se_get_product_image_post filter - image_url: %s, image_id: %s, size: %s',
        date('Y-m-d H:i:s'),
        $image_url,
        $image_id,
        $size
    );

    //    file_put_contents($log_file, $log_message . PHP_EOL, FILE_APPEND);

    // check if image id contain lptv model link, use it instead
    if (strpos($image_id, '/wp-content/plugins/lptv-plates/images/') !== false) {
        // add website url
        $image_url = get_bloginfo('url') . '/' . $image_id;
    }

    return $image_url;
}, 10, 3);

// hook rank math for og image
add_filter('rank_math/opengraph/facebook/image', 'lptv_rank_math_og_image');

function lptv_rank_math_og_image($image)
{
    if (is_product()) {
        global $product;

        // if this is WC_Product_LPTVplate
        if ($product->get_type() == 'lptvplate') {
            $image = $product->get_lptv_image_url();
        }
    }

    return $image;
}


/**
 * Add plate holder to cart when main product is added
 */
function lptv_add_plate_holder_to_cart($cart_item_key, $product_id, $quantity, $variation_id, $variation, $cart_item_data)
{

    // prevent infinite loop by checking if this is already a plate holder
    if (isset($cart_item_data['plate_holder_for'])) {
        return;
    }

    error_log('lptv_add_plate_holder_to_cart');
    error_log(print_r($_POST, true));

    // check if plate holder was selected
    if (isset($_POST['_plate_holder_id']) && !empty($_POST['_plate_holder_id'])) {
        $plate_holder_id = absint($_POST['_plate_holder_id']);

        // add plate holder to cart
        WC()->cart->add_to_cart(
            $plate_holder_id,
            1, // quantity
            0, // variation_id
            array(), // variation
            array(
                'plate_holder_for' => $product_id,
                'plate_holder_for_key' => $cart_item_key
            )
        );
    }
}
add_action('woocommerce_add_to_cart', 'lptv_add_plate_holder_to_cart', 10, 6);

/**
 * Display plate holder relationship in cart
 */
function lptv_cart_item_name($name, $cart_item, $cart_item_key)
{
    if (isset($cart_item['plate_holder_for'])) {
        $product = wc_get_product($cart_item['plate_holder_for']);
        if ($product) {
            $name .= ' (Plate Holder for: ' . $product->get_name() . ')';
        }
    }
    return $name;
}
add_filter('woocommerce_cart_item_name', 'lptv_cart_item_name', 10, 3);

