// print custom data on email
add_action('woocommerce_order_item_meta_end', 'lptvplate_print_metas', 3, 10);
function lptvplate_print_metas($item_id, $item, $order)
{

    foreach ($item->get_data()['meta_data'] as $data) {
        if ($data->key == '_plate_text1') {
            $text1 = $data->value;
            if ($text1 != '') {
                echo '<br/>text1:' . $text1;
            }
        }
        if ($data->key == '_plate_text2') {
            $text2 = $data->value;
            if ($text2 != '') {
                echo '<br/>text2:' . $text2;
            }
        }
        if ($data->key == '_decal_year') {
            $decal_year = $data->value;
            if ($decal_year != '') {
                echo '<br/>decal year:' . $decal_year;
            }
        }
    }
}


