// Register settings
add_action('admin_init', function () {
    register_setting('lptv_plates_license', 'lptv_plates_license_token', array(
        'sanitize_callback' => function ($value) {
            // Delete the transient when token is updated
            delete_transient('lptv_plates_license_status');
            return sanitize_text_field($value);
        }
    ));
});

// License settings page
function lptv_plates_license_page()
{
?>
    <div class="wrap">
        <h1>LPTV Plates License Settings</h1>
        <form method="post" action="options.php">
            <?php
            settings_fields('lptv_plates_license');
            do_settings_sections('lptv_plates_license');
            ?>
            <table class="form-table">
                <tr>
                    <th scope="row">License Token</th>
                    <td>
                        <input type="text" name="lptv_plates_license_token"
                            value="<?php echo esc_attr(get_option('lptv_plates_license_token')); ?>"
                            class="regular-text">
                    </td>
                </tr>
            </table>
            <?php submit_button(); ?>
        </form>
    </div>
    <?php
}

// check license function
function lptv_check_license()
{
    $local_token = get_option('lptv_plates_license_token');

    if (empty($local_token)) {
        return false;
    }

    $cached_status = get_transient('lptv_plates_license_check');

    if (
        is_array($cached_status)
        && isset($cached_status['token'], $cached_status['status'])
        && $cached_status['token'] === $local_token
    ) {
        return $cached_status['status'] === 'valid';
    }

    $response = wp_remote_get('http://devarea.flywheelsites.com/lptv/token.txt');

    if (is_wp_error($response)) {
        return false;
    }

    $remote_token = trim(wp_remote_retrieve_body($response));
    $is_valid = $local_token === $remote_token;

    set_transient(
        'lptv_plates_license_check',
        [
            'token' => $local_token,
            'status' => $is_valid ? 'valid' : 'invalid',
        ],
        HOUR_IN_SECONDS
    );

    return $is_valid;
}


// Main plugin initialization
function lptv_plates_init()
{

    if (!lptv_check_license()) {

        // Store the status in a transient to avoid checking on every request
        set_transient('lptv_plates_license_status', 'invalid', HOUR_IN_SECONDS);

        // Add admin notice
        add_action('admin_notices', function () {
    ?>
            <div class="notice notice-error">
                <p>LPTV Plates plugin is disabled. Invalid or missing license token. Please check your license settings.</p>
            </div>
    <?php
        });

        // Prevent plugin functionality
        remove_action('woocommerce_loaded', 'lptv_plates_init');
        return;
    } else {
        require_once 'includes/class-wc-product-lptvplate.php';
    }

    // License is valid, store status
    set_transient('lptv_plates_license_status', 'valid', HOUR_IN_SECONDS);
    
}


add_action('woocommerce_loaded', 'lptv_plates_init');
