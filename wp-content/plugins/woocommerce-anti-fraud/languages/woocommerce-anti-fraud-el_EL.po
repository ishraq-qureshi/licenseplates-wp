msgid "Support for the Anti-Fraud Plugin"
msgstr "Υποστήριξη για το plugin κατά της απάτης"

#: anti-fraud-core/class-wc-af-settings.php:598
msgid "Facing an Issue with the plugin?"
msgstr "Αντιμετωπίζοντας ένα πρόβλημα με το plugin;"

#: anti-fraud-core/class-wc-af-settings.php:599
msgid "Contact Our Support"
