msgid "Whitelist Payment Methods"
msgstr "Mètodes de pagament de la llista blanca"

#: anti-fraud-core/class-wc-af-settings.php:1148
msgid "Enable Whitelisting of Payment Methods"
msgstr "Activeu la llista blanca dels mètodes de pagament"

#: anti-fraud-core/class-wc-af-settings.php:1157
msgid "Select Payment Methods to be Whitelisted"
msgstr "Seleccioneu els mètodes de pagament per ser autoritzats"

#: anti-fraud-core/class-wc-af-settings.php:1171
msgid "User Roles Whitelisting"
msgstr "Rols d'usuari Whitelisting"

#: anti-fraud-core/class-wc-af-settings.php:1180
msgid "Enable Whitelisting of User Roles"
msgstr "Activa la llista blanca dels rols dels usuaris"

#: anti-fraud-core/class-wc-af-settings.php:1189
msgid "Select User Roles to be Whitelisted"
msgstr "Seleccioneu els rols de l'usuari per ser autoritzats"

#: anti-fraud-core/class-wc-af-settings.php:1195
msgid "Select roles"
msgstr "Seleccioneu els rols"

#: anti-fraud-core/class-wc-af-settings.php:1204
msgid "Whitelisted Emails"
msgstr "Correus electrònics de llista blanca"

#: anti-fraud-core/class-wc-af-settings.php:1213
msgid "Email Whitelist"
