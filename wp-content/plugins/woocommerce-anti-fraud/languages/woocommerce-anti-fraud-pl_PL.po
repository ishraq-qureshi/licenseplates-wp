msgstr "Zmień status zamówienia na podstawie oceny ryzyka"

#: anti-fraud-core/class-wc-af-settings.php:1104
msgid "Update Order Status based on Fraud Score"
msgstr "Aktualizacja statusu zamówienia na podstawie oceny oszustw"

