#: woocommerce-anti-fraud.php
msgid "WooCommerce Anti Fraud"
msgstr "WooC Commerce chống gian lận"

#. Plugin URI of the plugin
#: woocommerce-anti-fraud.php
msgid "https://woocommerce.com/products/woocommerce-anti-fraud/"
msgstr "https://woocommerce.com/products/woocommerce-anti-fraud/"

#. Description of the plugin
#: woocommerce-anti-fraud.php
msgid "Advanced fraud and card attack protection for WooCommerce, with risk scoring, rule-based controls, checkout protection, and tools to help merchants detect, prevent, and respond to suspicious activity."
msgstr "Chấm điểm từng giao dịch của bạn, kiểm tra khả năng gian lận có thể xảy ra, sử dụng bộ quy tắc tính điểm nâng cao."

