msgid ""
"<a href=\"https://maxmind.pxf.io/qnvxGg\" target=\"_blank\" >MaxMind "
"minFraud</a> is a paid, external service that uses machine learning to "
"detect potential fraud transactions. By using <a href=\"https://maxmind.pxf."
"io/qnvxGg\" target=\"_blank\" >minFraud</a> you can potentially detect more "
"fraudulent transactions.<br/>To sign up to MaxMind minFraud, click this "
"link: <a href=\"https://maxmind.pxf.io/qnvxGg\" target=\"_blank\">https://"
"maxmind.com</a><hr/>"
msgstr ""
"<a href=\"https://maxmind.pxf.io/qnvxGg\" target=\"_blank\" >MaxMind "
"minFraud</a> je platená externá služba, ktorá využíva strojové učenie na "
"zisťovanie potenciálnych podvodných transakcií. Pomocou <a href=\"https://"
"maxmind.pxf.io/qnvxGg\" target=\"_blank\" >minFraud</a> môžete potenciálne "
"odhaliť viac podvodných transakcií.<br/>Ak sa chcete zaregistrovať do "
"MaxMind minFraud, kliknite tento odkaz: <a href=\"https://maxmind.pxf.io/"
"qnvxGg\" target=\"_blank\">https://maxmind.com</a><hr/>"

#: anti-fraud-core/class-wc-af-settings.php:332
#: anti-fraud-core/class-wc-af-settings.php:452
#: anti-fraud-core/class-wc-af-settings.php:525
#: anti-fraud-core/class-wc-af-settings.php:898
