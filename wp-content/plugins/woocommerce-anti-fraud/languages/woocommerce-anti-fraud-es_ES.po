#: anti-fraud-core/class-wc-af-settings.php:1257
msgid "Auto Fraud Check For Existing Orders"
msgstr "Verificación de fraude automático para pedidos existentes"

#: anti-fraud-core/class-wc-af-settings.php:1266
msgid "Enable Auto Fraud Check"
msgstr "Habilitar la verificación de fraude automático"

#: anti-fraud-core/class-wc-af-settings.php:1276
msgid "No Of Days For Historical Orders Checks"
msgstr "No de días para controles de órdenes históricas"

#: anti-fraud-core/class-wc-af-settings.php:1298
msgid "Enable Debug Logging"
